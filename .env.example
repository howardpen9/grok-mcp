# --- Remote HTTP mode (grok-mcp-http / dist/http.js) ---

# Required on hosted deployments: xAI API key (https://console.x.ai).
# Without it the server falls back to the grok CLI, which is fragile on servers.
XAI_API_KEY=xai-...

# STRONGLY recommended: random path secret. The MCP endpoint becomes
# /mcp/<secret> instead of /mcp, so strangers can't spend your xAI credits.
# Generate: openssl rand -base64 32 | tr '+/' '-_'
GROK_MCP_PATH_SECRET=

# Listen address (most platforms inject PORT for you).
PORT=3000
HOST=0.0.0.0

# Optional hardening / tuning
# Comma-separated exact Host headers to accept (DNS-rebinding guard).
GROK_MCP_ALLOWED_HOSTS=
# Comma-separated CORS origins. Default: allow all (needed for claude.ai).
GROK_MCP_CORS_ORIGINS=
# JSON body size limit for /mcp requests. Default 2mb.
GROK_MCP_BODY_LIMIT=2mb

# --- Shared with stdio mode ---
# Per-call timeout in ms (keep BELOW your platform's request timeout).
GROK_MCP_TIMEOUT=300000
# Default model.
GROK_MCP_MODEL=grok-4
# api | cli | auto (default: api when XAI_API_KEY is set)
GROK_MCP_BACKEND=
